# CCN Business Management System - Environment Variables
# Copy this file to .env.local (local) or .env (production) and fill in values

# ============================================
# Supabase Configuration
# ============================================
# Get these from Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side/admin operations (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Optional: Local Development Overrides
# ============================================
# When using local Supabase (supabase start)
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your-local-anon-key

# ============================================
# Feature Flags
# ============================================
VITE_ENABLE_OFFLINE_SYNC=true
VITE_ENABLE_PORTAL_INTEGRATION=true
VITE_ENABLE_ADVANCED_REPORTS=false